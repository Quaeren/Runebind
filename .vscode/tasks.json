{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-D_GLIBCXX_ASSERTIONS",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lGLEW",
                "-lglfw",
                "-lGL",
                "-O2"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: portable release build",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-O2",
                "-DGLEW_STATIC",
                "${file}",
                "-o", "${fileDirname}/${fileBasenameNoExtension}",
                "-static-libstdc++", "-static-libgcc",
                "-l:libGLEW.a",
                "-lglfw",
                "-lGL"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ],
    "version": "2.0.0"
}